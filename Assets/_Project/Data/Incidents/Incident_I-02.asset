    entries:
    - crew: 2
      condition: 0
      outcome: 1
      explanation: "Mira t\xEDnh \u0111\xFAng v\xF2ng cung."
      quote: "T\xE2m b\xE3o \u1EDF \u0111\xE2y, ta \u1EDF \u0111\xE2y."
