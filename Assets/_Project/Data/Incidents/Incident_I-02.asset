    - crew: 0
      condition: 0
      outcome: 0
      explanation: "Ch\u1EDD b\xE3o tan, m\u1EA5t th\u1EDDi gian."
      quote: "Ch\u1EDD cho l\xE0nh."
      setFlag: 0
