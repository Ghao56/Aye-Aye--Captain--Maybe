    entries:
    - crew: 3
      condition: 0
      outcome: 1
      explanation: "Th\xE2n t\xE0u gia c\u1ED1 ch\u1ECBu \u0111\u01B0\u1EE3c s\xF3ng."
      quote: "S\xF3ng l\u1EDBn th\xEC t\xE0u ph\u1EA3i c\u1EE9ng."
