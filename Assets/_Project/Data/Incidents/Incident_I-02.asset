      cargoDelta: 0
      conditionDown: 0
      revenueDelta: 0
    - crew: 1
      condition: 0
      outcome: 2
      explanation: "Bob l\xE1i nh\u01B0 \u0111i m\xF4-t\xF4."
      quote: "Bay l\xEAn n\xE0o!"
      setFlag: 0
      cargoDelta: 0
      conditionDown: 1
      revenueDelta: 0
    - crew: 0
      condition: 0
      outcome: 0
      explanation: "T\xE0u rung l\u1EAFc nh\u01B0ng qua \u0111\u01B0\u1EE3c."
      quote: "C\u1EA7m ch\u1EB7t tay l\xE1i."
      setFlag: 0
      cargoDelta: 0
      conditionDown: 0
      revenueDelta: 0
  - label: "Neo ch\u1EDD"
