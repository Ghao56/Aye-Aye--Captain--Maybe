  m_Name: 
  m_EditorClassIdentifier: AyeAye.Runtime::AyeAye.IncidentDef
  incidentId: I-01
  title: "S\u01B0\u01A1ng m\xF9 d\xE0y"
  situationText: "B\u1EDD tr\u01B0\u1EDBc m\u0169i t\xE0u bi\u1EBFn m\u1EA5t trong
    s\u01B0\u01A1ng."
  clueText: "Mira c\xF3 s\xE1ch t\xEDn hi\u1EC7u c\u1EA3ng; Dex ng\u1EDD t\xEDn hi\u1EC7u."
  weight: 1
  triggers:
  - requiredHazard: 2
    requireFragileCargo: 0
    requireJustArrivedAtPort: 0
    requireWornCondition: 0
    requireTemporaryRepair: 0
    requireCarryingCargo: 0
    weightMultiplier: 1
  options:
  - label: "Gi\u1EEF t\u1ED1c \u0111\u1ED9"
    description: "Kh\xF4ng gi\u1EA3m t\u1ED1c."
    baseProgressDelta: 0.3
    entries:
    - crew: 1
      condition: 0
      outcome: 2
      explanation: "Bob lao th\u1EB3ng trong m\xF9."
      quote: "M\xF9 g\xEC m\xE0 m\xF9! V\xE0o th\xF4i!"
      setFlag: 0
      cargoDelta: 0
      conditionDown: 0
      revenueDelta: 0
    - crew: 0
      condition: 0
      outcome: 0
      explanation: "T\xE0u l\u01B0\u1EDBt qua m\xF9 m\xE0 kh\xF4ng b\u1ECB g\xEC
        \u2014 l\u1EA7n n\xE0y."
      quote: "Th\u1EA5y kh\xF4ng, c\u1EE9 ch\u1EA1y \u0111\u1EC1u."
      setFlag: 0
      cargoDelta: 0
      conditionDown: 0
      revenueDelta: 0
  - label: "Gi\u1EA3m t\u1ED1c d\xF2 \u0111\u01B0\u1EDDng"
    description: "Ch\u1EADm, b\u1EA5m c\xF2i li\xEAn t\u1EE5c."
    baseProgressDelta: 0
    entries:
    - crew: 0
      condition: 0
      outcome: 0
      explanation: "Ch\u1EADm nh\u01B0ng an to\xE0n."
      quote: "B\xEDp b\xEDp... b\xEDp..."
      setFlag: 0
      cargoDelta: 0
      conditionDown: 0
      revenueDelta: 0
    - crew: 3
      condition: 0
      outcome: 1
      explanation: "Chen nghe s\xF3ng, \u0111o m\xF9 ch\xEDnh x\xE1c."
      quote: "Ch\u1EADm m\u1ED9t nh\u1ECBp, \u0111\u1EE1 c\u1EA3 ng\xE0y."
      setFlag: 0
      cargoDelta: 0
      conditionDown: 0
      revenueDelta: 0
    - crew: 4
      condition: 0
      outcome: 0
      explanation: "Dex b\u1EA5m c\xF2i h\u01A1i nhi\u1EC1u."
      quote: "C\u1EA9n th\u1EADn kh\xF4ng bao gi\u1EDD l\xE0 th\u1EEBa."
      setFlag: 0
      cargoDelta: 0
      conditionDown: 0
      revenueDelta: 0
  - label: "Theo t\xEDn hi\u1EC7u c\u1EA3ng"
    description: "Nh\u1EDB s\u01A1 \u0111\u1ED3 \u0111\xE8n c\xE1c c\u1EA3ng."
    baseProgressDelta: 0
    entries:
    - crew: 2
      condition: 0
      outcome: 1
      explanation: "Mira \u0111\u1ECDc chu\u1EA9n s\xE1ch t\xEDn hi\u1EC7u."
      quote: "Trang 47: hai ch\u1EDBp, m\u1ED9t d\xE0i."
      setFlag: 0
      cargoDelta: 0
      conditionDown: 0
      revenueDelta: 0
    - crew: 4
      condition: 0
      outcome: 2
      explanation: "Dex \u0111\u1ECDc nh\u1EA7m \u0111\xE8n."
      quote: "Khoan... \u0111\xE8n \u0111\xF3 l\xE0 c\u1EE7a b\u1EBFn ph\u1EE5?"
      setFlag: 0
      cargoDelta: 0
      conditionDown: 0
      revenueDelta: 0
