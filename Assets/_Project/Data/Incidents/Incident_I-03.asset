      outcome: 0
      explanation: "\u0110\u01B0\u1EE3c qua, s\u1EA1c h\u1EE5t 20."
      quote: "\u0110\xE2y... coi nh\u01B0 ti\u1EC1n xe \xF4m."
      setFlag: 0
      cargoDelta: 0
      conditionDown: 0
      revenueDelta: -20
    - crew: 1
      condition: 0
      outcome: 1
      explanation: "Bob m\u1EB7c c\u1EA3 c\u1EF1c m\u1EA1nh, ph\xED r\u1EBB nh\u1EA5t."
      quote: "M\u01B0\u1EDDi ch\u1EE5c th\xF4i, \xF4ng n\u1ED9i!"
      setFlag: 0
      cargoDelta: 0
      conditionDown: 0
      revenueDelta: 0
  - label: "Ph\xF3ng nhanh tho\xE1t"
