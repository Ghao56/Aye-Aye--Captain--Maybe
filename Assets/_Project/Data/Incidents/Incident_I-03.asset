      conditionDown: 0
      revenueDelta: 0
  - label: "M\u1EB7c c\u1EA3 / \u0111\xE1nh l\u1EEBa"
    description: "Ch\xE9m gi\xF3 cho b\u1ECDn c\u01B0\u1EDBp quay \u0111\u1EA7u."
