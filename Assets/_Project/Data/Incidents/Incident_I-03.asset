    - crew: 1
      condition: 0
      outcome: 1
      explanation: "Kh\xF4ng t\xE0u n\xE0o nhanh h\u01A1n Tia Ch\u1EDBp."
      quote: "T\u1EA1m bi\u1EC7t, \u0111\xE0n c\xE1!"
