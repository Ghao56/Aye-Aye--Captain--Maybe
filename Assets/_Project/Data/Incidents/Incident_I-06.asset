  m_Script: {fileID: 11500000, guid: 8c8df58d36ca143459b80d6fc77627c7, type: 3}
  m_Name: Incident_I-06
  m_EditorClassIdentifier: AyeAye.Runtime::AyeAye.IncidentDef
  incidentId: I-06
  title: "M\xE1y m\xF3c h\u1ECFng"
  situationText: "M\u1ED9t ti\u1EBFng 'k\u1ECBch' d\u01B0\u1EDBi khoang, r\u1ED3i
    m\xE1y kh\u1EF1ng l\u1EA1i."
  clueText: "Mira \u0111\u1ECDc \u0111\u01B0\u1EE3c s\u01A1 \u0111\u1ED3 m\xE1y;
    Bob c\xF3 b\u1EADt 's\u1EEDa t\u1EA1m' tr\u01B0\u1EDBc."
  weight: 1
  triggers:
  - requiredHazard: 0
    requireFragileCargo: 0
    requireJustArrivedAtPort: 0
    requireWornCondition: 1
    requireTemporaryRepair: 0
    requireCarryingCargo: 0
    weightMultiplier: 1
  - requiredHazard: 0
    requireFragileCargo: 0
    requireJustArrivedAtPort: 0
    requireWornCondition: 0
    requireTemporaryRepair: 1
    requireCarryingCargo: 0
    weightMultiplier: 3
  options:
  - label: "S\u1EEDa chu\u1EA9n"
    description: "Ng\u1EEBng \u0111\u1EC3 s\u1EEDa \u0111\xFAng c\xE1ch, m\u1EA5t
      th\u1EDDi gian."
    baseProgressDelta: -1
    entries:
    - crew: 2
      condition: 0
      outcome: 1
      explanation: "Mira s\u1EEDa nhanh v\xE0 \u0111\xFAng."
      quote: "S\u01A1 \u0111\u1ED3 3B: thay r\u01A1-le s\u1ED1 hai."
      setFlag: 0
      cargoDelta: 0
      conditionDown: 0
      revenueDelta: 0
    - crew: 1
      condition: 0
      outcome: 0
      explanation: "Bob v\u1EB7n \u1ED1c ch\u1EADm r\xE3i."
      quote: "Kh\xF4ng g\xEC l\xE0 kh\xF4ng th\u1EC3 v\u1EB7n."
      setFlag: 0
      cargoDelta: 0
      conditionDown: 0
      revenueDelta: 0
    - crew: 3
      condition: 0
      outcome: 0
      explanation: "Chen s\u1EEDa ch\u1EAFc nh\u01B0 tr\u1ED3ng c\xE2y."
      quote: "T\u1EEB t\u1EEB, ch\u1EAFc tay."
      setFlag: 0
      cargoDelta: 0
      conditionDown: 0
      revenueDelta: 0
  - label: "S\u1EEDa t\u1EA1m"
    description: "B\u0103ng keo v\xE0 hy v\u1ECDng."
    baseProgressDelta: 0
    entries:
    - crew: 1
      condition: 0
      outcome: 1
      explanation: "Bob s\u1EEDa t\u1EA1m c\u1EF1c kh\xE9o."
      quote: "N\xF3 ch\u1EA1y r\u1ED3i! \u1EEB th\xEC\u2026 h\u01A1i rung, v\xE0
        c\xF3 ti\u1EBFng l\u1EA1 n\u1EEFa."
      setFlag: 2
      cargoDelta: 0
      conditionDown: 0
      revenueDelta: 0
    - crew: 4
      condition: 0
      outcome: 2
      explanation: "Dex s\u1EEDa t\u1EA1m l\xE0m m\xE1y t\u1EC7 h\u01A1n."
      quote: "R\xF5 r\xE0ng t\xF4i \u0111\xE3 n\u1ED1i \u0111\xFAng d\xE2y... d\xE2y
        n\xE0o?"
      setFlag: 0
      cargoDelta: 0
      conditionDown: 0
      revenueDelta: 0
