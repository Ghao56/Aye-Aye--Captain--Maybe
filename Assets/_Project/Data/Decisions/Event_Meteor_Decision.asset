MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3ea16a12c49a8b345a82bbb5d7acfe66, type: 3}
  m_Name: Event_Meteor_Decision
  m_EditorClassIdentifier: AyeAye.Runtime::AyeAye.DecisionDefinition
  prompt: "Ch\u1ECDn c\xE1ch \u0111i qua v\xF9ng thi\xEAn th\u1EA1ch."
  options:
  - label: "V\xF2ng theo r\xECa ph\u1EA3i"
    description: "Ch\u1EADm h\u01A1n, theo d\u1EEF li\u1EC7u c\u1EA3m bi\u1EBFn."
    entries:
    - crew: 2
      condition: 0
      outcome: 1
      explanation: "Mira b\xE1m \u0111\xFAng tuy\u1EBFn r\xECa ph\u1EA3i theo c\u1EA3m
        bi\u1EBFn. T\xE0u \u0111i \xEAm v\xE0 \u0111\xFAng l\u1ECBch."
      quote: "Tuy\u1EBFn r\xECa ph\u1EA3i. Ch\xEDnh x\xE1c t\u1EEBng m\xE9t."
      setFlag: 0
      cargoDelta: 0
  - label: "Xuy\xEAn th\u1EB3ng"
    description: "Nhanh nh\u1EA5t. Rung m\u1EA1nh."
    entries:
    - crew: 1
      condition: 0
      outcome: 1
      explanation: "Bob lao th\u1EB3ng qua v\xF9ng thi\xEAn th\u1EA1ch v\xE0 r\xFAt
        ng\u1EAFn \u0111\u01B0\u1EDDng \u0111i. Nh\u01B0ng th\xF9ng b\xE1nh b\u1ECB
        l\u1EC7ch kh\u1ECFi v\u1ECB tr\xED."
      quote: "Nhanh h\u01A1n m\xE0! Chi\u1EBFc b\xE1nh ch\u1EC9... nghi\xEAng m\u1ED9t
        ch\xFAt th\xF4i."
      setFlag: 1
      cargoDelta: 0
    - crew: 4
      condition: 0
      outcome: 2
      explanation: "Dex \u0111\u1ED5i h\u01B0\u1EDBng ba l\u1EA7n v\xEC tin thi\xEAn
        th\u1EA1ch nh\u1EAFm v\xE0o t\xE0u. C\u1EA3 \u0111\u1ED9i m\u1EA5t nhi\u1EC1u
        th\u1EDDi gian."
      quote: "Ch\xFAng \u0111ang \u0111\u1ED5i h\u01B0\u1EDBng theo ch\xFAng ta!"
      setFlag: 0
      cargoDelta: 0
  - label: "T\u1EAFt \u0111\u1ED9ng c\u01A1, tr\xF4i qua"
    description: "\xCAm nh\u01B0ng ch\u1EADm."
    entries:
    - crew: 3
      condition: 0
      outcome: 0
      explanation: "Chen t\u1EAFt \u0111\u1ED9ng c\u01A1 v\xE0 \u0111\u1EC3 t\xE0u
        tr\xF4i qua. Ch\u1EADm nh\u01B0ng y\xEAn \u1ED5n."
      quote: "Tr\xF4i c\u0169ng l\xE0 m\u1ED9t k\u1EF9 n\u0103ng."
      setFlag: 0
      cargoDelta: 0
