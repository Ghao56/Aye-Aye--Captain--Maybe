--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3ea16a12c49a8b345a82bbb5d7acfe66, type: 3}
  m_Name: Event_StardustFog_Decision
  m_EditorClassIdentifier: AyeAye.Runtime::AyeAye.DecisionDefinition
  prompt: "Ch\u1ECDn c\xE1ch v\u01B0\u1EE3t d\u1EA3i b\u1EE5i sao."
  options:
  - label: "Qu\xE9t b\u1EE5i kh\u1ECFi m\u1EB7t tr\u01B0\u1EDBc r\u1ED3i \u0111i
      ti\u1EBFp"
    description: "S\u1EA1ch k\xEDnh tr\u01B0\u1EDBc khi ch\u1EA1m v\xF9ng d\xE0y."
    entries:
    - crew: 1
      condition: 0
      outcome: 1
      explanation: "Bob qu\xE9t b\u1EE5i kh\u1ECFi m\u1EB7t tr\u01B0\u1EDBc t\xE0u
        tr\u01B0\u1EDBc khi ch\u1EA1m v\xF9ng d\xE0y. K\xEDnh s\u1EA1ch su\u1ED1t
        d\u1EA3i b\u1EE5i, t\xE0u \u0111i ngay."
      quote: "Qu\xE9t xong! K\xEDnh s\u1EA1ch. \u0110i ti\u1EBFp!"
      setFlag: 0
      cargoDelta: 0
    - crew: 0
      condition: 0
      outcome: 0
      explanation: "C\u1EA3 \u0111\u1ED9i qu\xE9t ph\u1EA7n b\u1EE5i quan tr\u1ECDng
        r\u1ED3i ti\u1EBFp t\u1EE5c h\xE0nh tr\xECnh."
      quote: "\u0110\xE3 qu\xE9t b\u1EE5i. L\u1ED9 tr\xECnh gi\u1EEF nguy\xEAn."
      setFlag: 0
      cargoDelta: 0
  - label: "Lu\u1ED3n s\xE1t sau v\u1EC7 tinh \u0111\u1EC3 b\u1EE5i l\u1EAFng"
    description: "M\u01B0\u1EE3n v\u1EC7t s\u1EA1ch c\u1EE7a v\u1EC7 tinh g\u1EA7n
      nh\u1EA5t."
    entries:
    - crew: 3
      condition: 0
      outcome: 1
      explanation: "Chen t\xEDnh l\u1ED9 tr\xECnh lu\u1ED3n sau v\u1EC7 tinh g\u1EA7n
        nh\u1EA5t: b\u1EE5i l\u1EAFng sau n\xF3 nh\u01B0 sau xe qu\xE9t. T\xE0u qua
        d\u1EA3i b\u1EE5i s\u1EA1ch v\xE0 s\u1EDBm."
      quote: "Sau v\u1EC7 tinh. V\u1EBFt b\u1EE5i r\u01A1i theo n\xF3. \u0110i."
      setFlag: 0
      cargoDelta: 0
    - crew: 4
      condition: 0
      outcome: 2
      explanation: "Dex nghi b\u1EE5i sao l\xE0 \"h\xF3a trang c\u1EE7a ai \u0111\xF3\"
        v\xE0 \u0111\u1ED5i l\u1ED9 tr\xECnh nhi\u1EC1u l\u1EA7n \u0111\u1EC3 ki\u1EC3m
        tra. M\u1EA5t th\u1EDDi gian."
      quote: "B\u1EE5i sao kh\xF4ng t\u1EF1 bay \u0111\u01B0\u1EE3c nh\u01B0 th\u1EBF.
        Ai ph\xF3ng n\xF3?"
      setFlag: 0
      cargoDelta: 0
  - label: "T\u1EAFt \u0111\xE8n \u0111\u1EC3 \u0111\u1EE1 b\xE1m b\u1EE5i"
    description: "\xC1p d\u1EE5ng m\u1EE5c \"ti\u1EBFt ki\u1EC7m n\u0103ng l\u01B0\u1EE3ng\"."
    entries:
    - crew: 2
      condition: 0
      outcome: 2
      explanation: "Mira t\u1EAFt \u0111\xE8n theo \u0111\xFAng m\u1EE5c \"ti\u1EBFt
        ki\u1EC7m n\u0103ng l\u01B0\u1EE3ng trong v\xF9ng b\u1EE5i\". B\u1EE5i kh\xF4ng
        b\u1EDBt, c\u1EA3 t\xE0u \u0111en thui v\xE0 t\u1EE5t l\u1ECBch."
      quote: "M\u1EE5c ti\u1EBFt ki\u1EC7m \u0111i\u1EC7n: \u0111\xE3 \xE1p d\u1EE5ng.
        K\u1EBFt qu\u1EA3: t\u1ED1i."
      setFlag: 0
      cargoDelta: 0
    - crew: 0
      condition: 0
      outcome: 0
      explanation: "C\u1EA3 \u0111\u1ED9i t\u1EAFt \u0111\xE8n ph\u1EE5 cho b\u1EDBt
        hao, r\u1ED3i m\u1EDF l\u1EA1i khi c\u1EA7n."
      quote: "\u0110\xE3 t\u1EAFt \u0111\xE8n ph\u1EE5. T\u1EA1m \u1ED5n."
      setFlag: 0
      cargoDelta: 0
