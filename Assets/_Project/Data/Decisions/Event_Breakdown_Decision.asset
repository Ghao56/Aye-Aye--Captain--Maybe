--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3ea16a12c49a8b345a82bbb5d7acfe66, type: 3}
  m_Name: Event_Breakdown_Decision
  m_EditorClassIdentifier: AyeAye.Runtime::AyeAye.DecisionDefinition
  prompt: "Ch\u1ECDn c\xE1ch s\u1EEDa h\u1EC7 th\u1ED1ng \u0111\u1EA9y."
  options:
  - label: "S\u1EEDa chu\u1EA9n theo s\xE1ch h\u01B0\u1EDBng d\u1EABn"
    description: "Ch\u1EADm nh\u01B0ng \u0111\xFAng t\u1EEBng b\u01B0\u1EDBc."
    entries:
    - crew: 2
      condition: 0
      outcome: 1
      explanation: "Mira \u0111\u1ECDc \u0111\xFAng t\u1EEBng b\u01B0\u1EDBc m\u1EE5c
        12 v\xE0 thay linh ki\u1EC7n chu\u1EA9n. H\u1EC7 th\u1ED1ng \u0111\u1EA9y
        ch\u1EA1y \xEAm, ch\u1EC9 t\u1ED1n nhi\u1EC1u gi\u1EDD."
      quote: "M\u1EE5c 12: ho\xE0n t\u1EA5t \u0111\xFAng quy tr\xECnh."
      setFlag: 0
      cargoDelta: 0
    - crew: 3
      condition: 0
      outcome: 0
      explanation: "Chen s\u1EEDa ch\u1EADm r\xE3i nh\u01B0ng kh\xF4ng l\xE0m h\u1ECFng
        g\xEC th\xEAm. H\u1EC7 th\u1ED1ng ch\u1EA1y l\u1EA1i \u0111\u01B0\u1EE3c."
      quote: "Xong. T\u1EA1m ch\u1EA1y \u0111\u01B0\u1EE3c."
      setFlag: 0
      cargoDelta: 0
    - crew: 1
      condition: 0
      outcome: 0
      explanation: "Bob l\xE0m theo s\xE1ch nh\u01B0ng l\u1EADt trang h\u01A1i v\u1ED9i.
        K\u1EBFt qu\u1EA3 v\u1EABn \u1ED5n."
      quote: "Theo s\xE1ch \u0111\u1EA5y! \u0110\xFAng s\xE1ch \u0111\u1EA5y!"
      setFlag: 0
      cargoDelta: 0
  - label: "S\u1EEDa t\u1EA1m cho ch\u1EA1y nhanh"
    description: "D\xE2y bu\u1ED9c, b\u0103ng keo v\xE0 nhi\u1EC7t t\xECnh."
    entries:
    - crew: 1
      condition: 0
      outcome: 1
      explanation: "Bob v\xE1 t\u1EA1m b\u1EB1ng d\xE2y bu\u1ED9c v\xE0 b\u0103ng
        keo d\xE1n h\u1ED3i cung c\u1EA5p. H\u1EC7 th\u1ED1ng \u0111\u1EA9y ch\u1EA1y
        l\u1EA1i ngay \u2014 h\u01A1i rung, c\xF3 ti\u1EBFng l\u1EA1, c\xF3 th\u1EC3
        ph\xE1t sinh chuy\u1EC7n sau n\xE0y."
      quote: "N\xF3 ch\u1EA1y r\u1ED3i! \u1EEB th\xEC\u2026 h\u01A1i rung, v\xE0
        c\xF3 ti\u1EBFng l\u1EA1 n\u1EEFa."
      setFlag: 2
      cargoDelta: 0
    - crew: 4
      condition: 0
      outcome: 2
      explanation: "Dex ki\u1EC3m tra b\u1ED9 ph\u1EADn qu\xE1 l\xE2u v\xEC nghi
        ti\u1EBFng \u0111\u1ED9ng, r\u1ED3i l\u1EAFp nh\u1EA7m th\u1EE9 t\u1EF1 \u1ED1c.
        M\u1EA5t th\xEAm th\u1EDDi gian."
      quote: "T\xF4i nghe th\u1EA5y n\xF3 r\xEDt l\xEAn. N\xF3 r\xEDt l\xEAn nh\u01B0
        m\u1ED9t l\u1EDDi \u0111e d\u1ECDa."
      setFlag: 0
      cargoDelta: 0
  - label: "G\u1ECDi tr\u1EA1m h\u1ED7 tr\u1EE3 t\u1EEB xa"
    description: "H\u1ECFi qua s\xF3ng, ch\u1EDD h\u01B0\u1EDBng d\u1EABn."
    entries:
    - crew: 0
      condition: 0
      outcome: 0
      explanation: "G\u1ECDi tr\u1EA1m h\u1ED7 tr\u1EE3: k\u1EF9 thu\u1EADt vi\xEAn
        h\u01B0\u1EDBng d\u1EABn qua s\xF3ng. H\u1EC7 th\u1ED1ng ch\u1EA1y l\u1EA1i
        \u0111\u01B0\u1EE3c sau m\u1ED9t l\xFAc ch\u1EDD t\xEDn hi\u1EC7u."
      quote: "\u0110\xE3 k\u1EBFt n\u1ED1i tr\u1EA1m h\u1ED7 tr\u1EE3. \u0110ang
        ch\u1EDD h\u01B0\u1EDBng d\u1EABn."
      setFlag: 0
      cargoDelta: 0
