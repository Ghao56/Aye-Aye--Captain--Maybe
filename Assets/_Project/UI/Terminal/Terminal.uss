/* Terminal UI — toàn bộ số đo nằm ở đây (R6).
   Stage 1920x1280 (giữ đúng tỉ lệ ảnh máy tính 1536x1024 = 3:2, rộng tối đa 1920).
   Rect màn hình (% trên ảnh gốc 1536x1024): left 300, top 85, width 975, height 690. */

:root {
    --c-letterbox: rgb(0, 0, 0);
    --c-screen-bg: rgba(4, 16, 10, 0.60);   /* phủ nhẹ lên kính CRT cong, làm đều nền */
    --c-text: rgb(155, 232, 164);            /* xanh lá nhạt (khớp UI cũ #9BE8A4) */
    --c-amber: rgb(255, 184, 77);            /* hổ phách #FFB84D */
    --c-alert: rgb(255, 90, 77);             /* đỏ cảnh báo #FF5A4D */
    --c-frame: rgb(46, 107, 71);             /* viền khung terminal */
    --c-fragile: rgb(255, 184, 77);          /* chip Dễ vỡ — hổ phách */
    --c-cold: rgb(120, 200, 255);            /* chip Lạnh — xanh băng */
    --c-urgent: rgb(255, 90, 77);            /* chip Khẩn — đỏ */
    --c-plain: rgb(110, 150, 120);           /* chip Hàng Thường */
}

/* Container world-space (kiến trúc B): lấp vừa khít vùng worldSpaceSize của UIDocument.
   Letterbox do camera world lo — không cần nền nữa. */
.root {
    width: 100%;
    height: 100%;
    overflow: hidden;
}

/* Sân khấu cố định 1920x1280 px = 19.2x12.8 world unit (PPU 100) */
.stage {
    width: 1920px;
    height: 1280px;
    flex-shrink: 0;
}

/* Ảnh máy tính KHÔNG nằm trong panel nữa — vẽ bằng SpriteRenderer "ImagePreview"
   trên GameObject Terminal (kiến trúc B, người dùng yêu cầu 12/11/2026). */

/* Vùng kính màn hình CRT (cong + bo góc) — nội dung nằm trong padding để chừa lề (R-14 phương án a) */
.screen {
    position: absolute;
    left: 19.53%;      /* 300 / 1536 */
    top: 8.30%;        /* 85 / 1024 */
    width: 63.48%;     /* 975 / 1536 */
    height: 67.38%;    /* 690 / 1024 */
    overflow: hidden;
    background-color: var(--c-screen-bg);
    padding: 28px 38px;
}

/* Overlay căn chỉnh GATE B: đã duyệt ngày 11/11/2026 → ẩn mặc định */
.debug-overlay {
    display: none;
    position: absolute;
    left: 19.53%;
    top: 8.30%;
    width: 63.48%;
    height: 67.38%;
    border-width: 2px;
    border-color: rgb(255, 0, 255);
    background-color: rgba(255, 0, 255, 0.25);
}

/* Hiệu ứng TV bật khi mở màn (zoom) — picking-mode Ignore (R-01) */
.tv-fx {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(2, 8, 5);
    display: none;
}

.tv-line {
    position: absolute;
    left: 0;
    top: 50%;
    width: 0%;
    height: 2%;
    background-color: rgb(220, 255, 230);
}

/* === Bước 2: khung game (FR-0201..0203) — biến màu tái dùng từ :root === */

.game {
    flex-grow: 1;   /* lấp phần còn lại trong padding .screen */
    display: none;  /* TerminalHud bật khi máy đã bật (CRT on) */
}

.game.on { display: flex; }

/* Cột dọc của .game: hàng cố định (topbar/tabbar/footer shrink 0)
   → content co giãn phần còn lại (shrink 1 + min-height 0) để footer luôn trong kính. */
.topbar, .tabbar, .bottombar { flex-shrink: 0; }

/* Thanh trên */
.topbar {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 10px;
    border-bottom-width: 2px;
    border-bottom-color: var(--c-frame);
}
.topbar-item { color: var(--c-text); font-size: 26px; }
.topbar-item.phase { color: var(--c-amber); }

/* Tab */
.tabbar {
    flex-direction: row;
    padding: 4px 10px;
    border-bottom-width: 2px;
    border-bottom-color: var(--c-frame);
}
.tab {
    margin-right: 12px;
    padding: 4px 14px;
    font-size: 26px;
    color: var(--c-text);
    border-width: 2px;
    border-color: var(--c-frame);
    background-color: rgba(46, 107, 71, 0.25);
}
.tab.selected { color: rgb(2, 12, 6); background-color: var(--c-text); }
.tab.locked { color: var(--c-alert); border-color: var(--c-alert); background-color: transparent; }
.tab-badge {
    font-size: 20px;
    color: var(--c-alert);
    margin-left: 6px;
}

/* Nội dung tab: co được + min-height 0 để không đẩy footer ra ngoài kính */
.content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}
.panel { display: none; flex-grow: 1; min-height: 0; padding: 8px 10px; }
.panel.on { display: flex; flex-direction: column; }
.panel-hint { color: var(--c-text); font-size: 24px; }

/* Footer: nút Rời máy (trái) + nút pha (phải). Thanh LUÔN hiện — ẩn riêng nút pha. */
.bottombar {
    flex-direction: row;
    justify-content: space-between;
    padding: 8px 10px;
}
.exit-machine {
    padding: 2px 8px;
    font-size: 20px;
    color: var(--c-amber);
    border-width: 1px;
    border-color: var(--c-frame);
    background-color: transparent;
}
.exit-machine:hover { border-color: var(--c-amber); }
.bottom-button {
    padding: 8px 24px;
    font-size: 30px;
    color: rgb(2, 12, 6);
    background-color: var(--c-text);
    border-width: 0;
}
.bottom-button:disabled { opacity: 0.4; }

/* Màn Start/Restart (FR-0101) */
.start-screen {
    position: absolute;
    left: 0; top: 0;
    width: 100%; height: 100%;
    background-color: rgba(2, 10, 6, 0.92);
    align-items: center;
    justify-content: center;
}
.start-title { color: var(--c-text); font-size: 52px; margin-bottom: 24px; }
.start-button {
    margin: 6px 0;
    padding: 8px 32px;
    font-size: 30px;
    color: var(--c-text);
    border-width: 2px;
    border-color: var(--c-frame);
    background-color: transparent;
}

/* === Bước 3: tab ĐƠN HÀNG (FR-03xx) === */

.orders-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }

.section-title {
    color: var(--c-amber);
    font-size: 28px;
    margin: 12px 0 6px 0;
}

.order-card {
    border-width: 2px;
    border-color: var(--c-frame);
    padding: 8px 12px;
    margin-bottom: 8px;
}

.order-title { color: var(--c-text); font-size: 27px; }
.order-line { color: var(--c-text); font-size: 23px; }
.order-clue { color: var(--c-amber); }
.order-warn { color: var(--c-alert); }

.order-active {
    border-left-width: 4px;
    border-left-color: var(--c-frame);
    padding: 4px 0 4px 10px;
    margin-bottom: 6px;
}

.btn-row { flex-direction: row; align-items: center; margin-top: 6px; }
.btn-row Button {
    padding: 2px 16px;
    margin-right: 10px;
    font-size: 24px;
    color: rgb(2, 12, 6);
    border-width: 0;
}
.btn-accept { background-color: var(--c-text); }
.btn-accept:hover { background-color: rgb(200, 255, 210); }
.btn-accept:disabled { opacity: 0.4; background-color: var(--c-text); }
.btn-decline {
    color: var(--c-text);
    background-color: transparent;
    border-width: 2px;
    border-color: var(--c-alert);
}
.btn-decline:hover { background-color: rgba(255, 90, 77, 0.25); }
.btn-decline:disabled { opacity: 0.4; }

/* Tóm tắt đầu tab + hàng chip hàng hóa */
.order-summary { color: var(--c-text); font-size: 25px; margin-bottom: 4px; }
.order-main { flex-direction: row; align-items: center; margin-top: 2px; }
.chip-row { flex-direction: row; margin-left: 10px; }
.chip {
    margin-right: 6px;
    padding: 0 8px;
    font-size: 19px;
    border-width: 1px;
    border-radius: 10px;
}
.chip-plain { color: var(--c-plain); border-color: var(--c-plain); }
.chip-fragile { color: var(--c-fragile); border-color: var(--c-fragile); }
.chip-cold { color: var(--c-cold); border-color: var(--c-cold); }
.chip-urgent { color: var(--c-urgent); border-color: var(--c-urgent); }

/* === G3: tab ĐỘI TÀU — bản đồ hình sao + thẻ tàu + panel lệnh (FR-04xx) === */

.fleet-row {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: row;
}

/* Bản đồ ~60% bên trái; cạnh vẽ bằng Painter2D (generateVisualContent). */
.fleet-map {
    flex-grow: 3;
    flex-shrink: 1;
    min-height: 0;
    margin-right: 12px;
    border-width: 2px;
    border-color: var(--c-frame);
    background-color: rgba(4, 16, 10, 0.35);
}

.fleet-side {
    flex-grow: 2;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
}

.fleet-cards { flex-grow: 1; flex-shrink: 1; min-height: 0; }

.ship-card {
    border-width: 2px;
    border-color: var(--c-frame);
    padding: 8px 12px;
    margin-bottom: 8px;
}
.ship-card.selected { border-color: var(--c-amber); }

.fleet-commands {
    flex-shrink: 0;
    border-width: 2px;
    border-color: var(--c-frame);
    padding: 8px 12px;
    margin-top: 8px;
}

/* Nút chọn tuyến RouteOption — viền, khi được chọn thành nền hổ phách */
.btn-route {
    color: var(--c-text);
    background-color: transparent;
    border-width: 2px;
    border-color: var(--c-frame);
    padding: 2px 12px;
    margin-right: 10px;
    margin-bottom: 6px;
    font-size: 22px;
}
.btn-route:hover { border-color: var(--c-amber); }
.btn-route.selected { color: rgb(2, 12, 6); background-color: var(--c-amber); border-color: var(--c-amber); }

/* Nút hành tinh / trạm: tọa độ do C# đặt (PortDef.mapPosition), kích thước nằm ở đây. */
.map-node {
    position: absolute;
    translate: -50% -50%;
    align-items: center;
}
.map-hq {
    width: 46px;
    height: 46px;
    background-color: var(--c-amber);
    border-width: 2px;
    border-color: var(--c-text);
}
.map-planet {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: var(--c-text);
    border-width: 2px;
    border-color: var(--c-frame);
}
.map-node-label {
    color: var(--c-text);
    font-size: 22px;
    margin-top: 4px;
    white-space: nowrap;
}

/* Chấm tàu: nhỏ, tròn, màu theo thuyền trưởng (dot-0..3), chọn → viền sáng */
.map-dot {
    position: absolute;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border-width: 2px;
    border-color: rgb(2, 12, 6);
    translate: -50% -50%;
}
.dot-0 { background-color: var(--c-text); }
.dot-1 { background-color: var(--c-cold); }
.dot-2 { background-color: var(--c-amber); }
.dot-3 { background-color: var(--c-alert); }
.map-dot.selected { width: 28px; height: 28px; border-color: rgb(255, 255, 255); }

/* Chú giải hazard — màu phải khớp HazardColor trong TerminalHud.Fleet.cs */
.map-legend {
    position: absolute;
    left: 8px;
    top: 8px;
    flex-direction: row;
    flex-wrap: wrap;
}
:root {
    --c-h-clear: rgb(107, 122, 89);
    --c-h-fog: rgb(158, 181, 201);
    --c-h-storm: rgb(217, 161, 74);
    --c-h-pirates: rgb(191, 92, 77);
    --c-h-ice: rgb(112, 184, 201);
}
.chip-h-clear { color: var(--c-h-clear); border-color: var(--c-h-clear); }
.chip-h-fog { color: var(--c-h-fog); border-color: var(--c-h-fog); }
.chip-h-storm { color: var(--c-h-storm); border-color: var(--c-h-storm); }
.chip-h-pirates { color: var(--c-h-pirates); border-color: var(--c-h-pirates); }
.chip-h-ice { color: var(--c-h-ice); border-color: var(--c-h-ice); }
