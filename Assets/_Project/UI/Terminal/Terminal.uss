/* Terminal UI — toàn bộ số đo nằm ở đây (R6).
   Stage 1920x1280 (giữ đúng tỉ lệ ảnh máy tính 1536x1024 = 3:2, rộng tối đa 1920).
   Rect màn hình (% trên ảnh gốc 1536x1024): left 300, top 85, width 975, height 690. */

/* G4 — CRT đơn sắc: MỘT màu phosphor xanh lá, mọi khác biệt thông tin thể hiện bằng
   độ sáng / hình dạng / ký hiệu / đảo màu / nhấp nháy — không bằng màu.
   Bốn giá trị duy nhất của UI:
   --c-text  nội dung chính (sáng nhất)
   --c-dim   nhãn phụ, clue, disabled
   --c-faint viền, khung, đường kẻ
   --c-ink   chữ trên nền đảo màu */
:root {
    --c-letterbox: rgb(0, 0, 0);
    --c-screen-bg: rgba(4, 16, 10, 0.60);   /* phủ nhẹ lên kính CRT cong, làm đều nền */
    --c-text: rgb(155, 232, 164);
    --c-dim: rgb(95, 150, 105);
    --c-faint: rgb(46, 107, 71);
    --c-ink: rgb(2, 12, 6);
}

/* Container world-space (kiến trúc B): lấp vừa khít vùng worldSpaceSize của UIDocument.
   Letterbox do camera world lo — không cần nền nữa. */
.root {
    width: 100%;
    height: 100%;
    overflow: hidden;
}

/* Sân khấu cố định 1920x1280 px = 19.2x12.8 world unit (PPU 100) */
.stage {
    width: 1920px;
    height: 1280px;
    flex-shrink: 0;
}

/* Ảnh máy tính KHÔNG nằm trong panel nữa — vẽ bằng SpriteRenderer "ImagePreview"
   trên GameObject Terminal (kiến trúc B, người dùng yêu cầu 12/11/2026). */

/* Vùng kính màn hình CRT (cong + bo góc) — nội dung nằm trong padding để chừa lề (R-14 phương án a) */
.screen {
    position: absolute;
    left: 19.53%;      /* 300 / 1536 */
    top: 8.30%;        /* 85 / 1024 */
    width: 63.48%;     /* 975 / 1536 */
    height: 67.38%;    /* 690 / 1024 */
    overflow: hidden;
    background-color: var(--c-screen-bg);
    padding: 28px 38px;
}

/* Overlay căn chỉnh GATE B: đã duyệt ngày 11/11/2026 → ẩn mặc định (debug, ngoài bốn giá trị phosphor) */
.debug-overlay {
    display: none;
    position: absolute;
    left: 19.53%;
    top: 8.30%;
    width: 63.48%;
    height: 67.38%;
    border-width: 2px;
    border-color: rgb(255, 0, 255);
    background-color: rgba(255, 0, 255, 0.25);
}

/* Hiệu ứng TV bật khi mở màn (zoom) — picking-mode Ignore (R-01) */
.tv-fx {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(2, 8, 5);
    display: none;
}

.tv-line {
    position: absolute;
    left: 0;
    top: 50%;
    width: 0%;
    height: 2%;
    background-color: rgb(220, 255, 230);
}

/* === Bước 2: khung game (FR-0201..0203) — biến màu tái dùng từ :root === */

.game {
    flex-grow: 1;   /* lấp phần còn lại trong padding .screen */
    display: none;  /* TerminalHud bật khi máy đã bật (CRT on) */
}

.game.on { display: flex; }

/* Cột dọc của .game: hàng cố định (topbar/tabbar/footer shrink 0)
   → content co giãn phần còn lại (shrink 1 + min-height 0) để footer luôn trong kính. */
.topbar, .tabbar, .bottombar { flex-shrink: 0; }

/* Thanh trên */
.topbar {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 10px;
    border-bottom-width: 2px;
    border-bottom-color: var(--c-faint);
}
.topbar-item { color: var(--c-text); font-size: 26px; }
.topbar-item.phase { color: var(--c-text); }

/* Tab */
.tabbar {
    flex-direction: row;
    padding: 4px 10px;
    border-bottom-width: 2px;
    border-bottom-color: var(--c-faint);
}
.tab {
    margin-right: 12px;
    padding: 4px 14px;
    font-size: 26px;
    color: var(--c-text);
    border-width: 2px;
    border-color: var(--c-faint);
    background-color: rgba(46, 107, 71, 0.25);
}
.tab.selected { color: var(--c-ink); background-color: var(--c-text); }
/* Khóa: viền mờ + chữ mờ (USS không có border nét đứt — phân biệt bằng độ sáng) */
.tab.locked { color: var(--c-dim); border-color: var(--c-faint); background-color: transparent; }
.tab-badge {
    font-size: 20px;
    color: var(--c-text);
    margin-left: 6px;
}

/* Nội dung tab: co được + min-height 0 để không đẩy footer ra ngoài kính.
   Hướng cột đặt theo từng panel (.panel-orders / .panel-fleet) — KHÔNG để quy tắc chung
   của tab ĐƠN HÀNG áp lên tab khác (G3: panel-1 cần hướng hàng). */
.content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}
.panel { display: none; flex-grow: 1; min-height: 0; padding: 8px 10px; }
.panel.on { display: flex; }
.panel-orders { flex-direction: column; }
.panel-fleet { flex-direction: row; }
.panel-hint { color: var(--c-text); font-size: 24px; }

/* Footer: nút Rời máy (trái) + nút pha (phải). Thanh LUÔN hiện — ẩn riêng nút pha. */
.bottombar {
    flex-direction: row;
    justify-content: space-between;
    padding: 8px 10px;
}
.exit-machine {
    padding: 2px 8px;
    font-size: 20px;
    color: var(--c-dim);
    border-width: 1px;
    border-color: var(--c-faint);
    background-color: transparent;
}
.exit-machine:hover { border-color: var(--c-dim); }
.bottom-button {
    padding: 8px 24px;
    font-size: 30px;
    color: var(--c-ink);
    background-color: var(--c-text);
    border-width: 0;
}
.bottom-button:disabled { opacity: 0.4; }

/* Màn Start/Restart (FR-0101) */
.start-screen {
    position: absolute;
    left: 0; top: 0;
    width: 100%; height: 100%;
    background-color: rgba(2, 10, 6, 0.92);
    align-items: center;
    justify-content: center;
}
.start-title { color: var(--c-text); font-size: 52px; margin-bottom: 24px; }
.start-hint { color: var(--c-dim); font-size: 22px; margin-bottom: 24px; white-space: normal; -unity-text-align: middle-center; }
.start-button {
    margin: 6px 0;
    padding: 8px 32px;
    font-size: 30px;
    color: var(--c-text);
    border-width: 2px;
    border-color: var(--c-faint);
    background-color: transparent;
}

/* === Bước 3: tab ĐƠN HÀNG (FR-03xx) === */

.orders-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }

.section-title {
    color: var(--c-text);
    font-size: 28px;
    margin: 12px 0 6px 0;
}

.order-card {
    border-width: 2px;
    border-color: var(--c-faint);
    padding: 8px 12px;
    margin-bottom: 8px;
}

.order-title { color: var(--c-text); font-size: 27px; }
.order-line { color: var(--c-text); font-size: 23px; }
.order-clue { color: var(--c-dim); }
/* Cảnh báo: cùng phosphor sáng, phân biệt bằng tiền tố "! " do C# thêm */
.order-warn { color: var(--c-text); }
/* Cảnh báo hạn đơn (G4): nhấp nháy qua class blink-off (toggle 0.5s trong UpdateCountdowns) */
.order-line.blink-off { opacity: 0.25; }
/* Đơn TRỄ: đảo màu cố định */
.order-line.late { background-color: var(--c-text); color: var(--c-ink); }

.order-active {
    border-left-width: 4px;
    border-left-color: var(--c-faint);
    padding: 4px 0 4px 10px;
    margin-bottom: 6px;
}

.btn-row { flex-direction: row; align-items: center; margin-top: 6px; }
.btn-row Button {
    padding: 2px 16px;
    margin-right: 10px;
    font-size: 24px;
    color: var(--c-ink);
    border-width: 0;
}
/* Đè .btn-row Button (class+type thắng 1 class) — nút decline/route trong hàng phải giữ màu riêng. */
.btn-row .btn-accept { background-color: var(--c-text); }
.btn-row .btn-accept:hover { background-color: var(--c-dim); }
.btn-row .btn-accept:disabled { opacity: 0.4; background-color: var(--c-text); }
/* Từ chối: nút phụ — viền + chữ mờ, hover đảo màu (nền mờ, chữ ink). Không dùng đỏ. */
.btn-decline {
    color: var(--c-dim);
    background-color: transparent;
    border-width: 2px;
    border-color: var(--c-dim);
}
.btn-row .btn-decline { color: var(--c-dim); background-color: transparent; border-width: 2px; border-color: var(--c-dim); }
.btn-decline:hover { color: var(--c-ink); background-color: var(--c-dim); }
.btn-row .btn-decline:hover { color: var(--c-ink); background-color: var(--c-dim); }
.btn-decline:disabled { opacity: 0.4; }
.btn-row .btn-decline:disabled { opacity: 0.4; }

/* Tóm tắt đầu tab + hàng chip hàng hóa */
.order-summary { color: var(--c-text); font-size: 25px; margin-bottom: 4px; }
.order-main { flex-direction: row; align-items: center; margin-top: 2px; }
.chip-row { flex-direction: row; margin-left: 10px; }
.chip {
    margin-right: 6px;
    padding: 0 8px;
    font-size: 19px;
    border-width: 1px;
    border-radius: 10px;
}
/* G4 — chip phân biệt bằng ký hiệu ([!] Dễ vỡ, [*] Lạnh, [>>] Khẩn) + kiểu chip, không bằng màu:
   thường = mờ; fragile/cold = sáng; khẩn = đảo màu. */
.chip-plain { color: var(--c-dim); border-color: var(--c-faint); }
.chip-fragile { color: var(--c-text); border-color: var(--c-text); }
.chip-cold { color: var(--c-text); border-color: var(--c-text); }
.chip-urgent { color: var(--c-ink); background-color: var(--c-text); border-color: var(--c-text); }

/* === G3+G6.3: tab ĐỘI TÀU (FR-04xx) — kính thật ~1207x679 px thiết kế (zoomOutFactor 1.27 +
   scale máy 0.22, TerminalView.FitScreenToFrame), nên bố cục 2 cột: trái = bản đồ (min 300px)
   + đơn chờ dưới bản đồ (thẻ 2 dòng, ~2 thẻ trong khung, dư thì cuộn); phải = MỘT ScrollView
   (thẻ tàu + panel lệnh tối giản). Hết chỗ → CUỘN trong vùng của mình, không chồng vùng khác. */

.panel-fleet { flex-direction: column; }

.fleet-row {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: row;
    overflow: hidden;
}

/* Trái: bản đồ + hàng đơn chờ. overflow:hidden — không bao giờ vẽ đè sang cột phải. */
.fleet-left {
    flex-basis: 58%;
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
}

.fleet-map {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 300px;
    border-width: 2px;
    border-color: var(--c-faint);
    background-color: rgba(4, 16, 10, 0.35);
}

/* Đơn chờ: thẻ 2 dòng (khách→đích / hạn+doanh thu+chip), khung ~2 thẻ, dư thì cuộn. */
.fleet-orders {
    flex-direction: column;
    flex-shrink: 0;
    margin-top: 8px;
}
.fleet-orders .section-title, .fleet-side .section-title {
    font-size: 22px;
    margin: 0 0 6px 0;
}
.fleet-orders-scroll { max-height: 124px; }
.fleet-orders-row { flex-direction: column; }
.fleet-order-card {
    flex-direction: column;
    align-items: stretch;
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
    overflow: hidden;
    border-width: 2px;
    border-color: var(--c-faint);
    padding: 2px 8px;
    margin-bottom: 6px;
}
.fleet-order-card .order-title {
    font-size: 20px;
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
/* Dòng 2: hạn (10 Hz) + doanh thu + chip ký hiệu — gọn, không tràn. */
.fleet-order-meta {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}
.fleet-order-meta .order-line { font-size: 20px; flex-shrink: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fleet-order-meta .chip { flex-shrink: 0; margin-left: 8px; font-size: 20px; }

/* Phải: MỘT ScrollView duy nhất chứa thẻ tàu + thanh lệnh — không lồng ScrollView. */
.fleet-side {
    flex-basis: 42%;
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    margin-left: 10px;
    overflow: hidden;
}
.fleet-side-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* Thẻ tàu: 1 cột (cột phải hẹp) — thẻ nào cũng trọn vẹn trong dòng cuộn của mình. */
.ship-grid {
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 0;
}

/* Chữ dài trong thanh lệnh phải xuống dòng, không cắt mép phải (Label mặc định nowrap).
   Thẻ tàu/thẻ đơn xử lý riêng bằng ellipsis — tab ĐƠN HÀNG dùng chung .order-title/.order-line. */
.fleet-cmd .order-title, .fleet-cmd .order-line { white-space: normal; }

.ship-grid .ship-card {
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0 0 8px 0;
    padding: 4px 10px;
}

.ship-card {
    border-width: 2px;
    border-color: var(--c-faint);
    min-width: 0;
    overflow: hidden;
}
.ship-card .order-title { font-size: 22px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* Vị trí/đội ngũ: 1 dòng + ellipsis — chi tiết đầy đủ ở tooltip của thẻ. */
.ship-card .order-line {
    font-size: 20px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.ship-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-width: 0;
}
.ship-head .order-title { flex-shrink: 1; min-width: 0; }
.ship-status { color: var(--c-dim); font-size: 20px; flex-shrink: 0; margin-left: 8px; }
/* Đang chọn: đảo màu (nền sáng, chữ ink) — không viền hổ phách */
.ship-card.selected { background-color: var(--c-text); border-color: var(--c-text); }
.ship-card.selected .order-title, .ship-card.selected .order-line { color: var(--c-ink); }
.ship-card.selected .ship-status { color: var(--c-ink); }
/* Nhận được đơn đang chọn: viền sáng; không khả dụng: mờ đi */
.ship-card.compatible { border-color: var(--c-text); }
.ship-card.dimmed { opacity: 0.45; }
.ship-card:hover { border-color: var(--c-dim); }

/* Trạng thái thẻ đơn (chọn/nhận được/mờ) — bố cục thẻ nằm ở khối 2 cột phía trên. */
.fleet-order-card.selected { background-color: var(--c-text); border-color: var(--c-text); }
.fleet-order-card.selected .order-title, .fleet-order-card.selected .order-line { color: var(--c-ink); }
.fleet-order-card.compatible { border-color: var(--c-text); }
.fleet-order-card.dimmed { opacity: 0.45; }
.fleet-order-card:hover { border-color: var(--c-dim); }

/* Panel lệnh tối giản (G6.3): 1 dòng hướng dẫn + tối đa 2 nút tuyến TO + nút phụ nhỏ.
   Mọi Label trong panel white-space normal (đè Label mặc định nowrap) — dài thì xuống dòng,
   không cắt mép phải cột. */
.fleet-cmd {
    flex-shrink: 0;
    border-width: 2px;
    border-color: var(--c-faint);
    padding: 6px 10px;
    margin-top: 8px;
}
.fleet-cmd .order-line { font-size: 20px; }
.fleet-cmd-note { flex-direction: column; }
.fleet-cmd-actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 4px;
}
.fleet-feedback { color: var(--c-text); }

/* Nút tuyến TO trong panel lệnh (NHANH · 20s · ! Sương mù) — to hơn nút thường. */
.btn-big {
    padding: 4px 14px;
    margin: 0 8px 6px 0;
    font-size: 22px;
}

/* Nút phụ nhỏ viền mờ: điều tàu rỗng / quay lại giao đơn. */
.btn-sub {
    color: var(--c-dim);
    background-color: transparent;
    border-width: 2px;
    border-color: var(--c-faint);
    padding: 2px 10px;
    margin: 6px 8px 0 0;
    font-size: 20px;
}
.btn-sub:hover { border-color: var(--c-dim); }

/* 2 nút chuyển chế độ panel lệnh (GIAO ĐƠN / ĐIỀU TÀU RỖNG) — viền, chọn thành nền sáng */
.btn-mode {
    color: var(--c-text);
    background-color: transparent;
    border-width: 2px;
    border-color: var(--c-faint);
    padding: 2px 12px;
    margin-right: 10px;
    margin-bottom: 6px;
    font-size: 22px;
}
.btn-mode:hover { border-color: var(--c-dim); }
.btn-mode.selected { color: var(--c-ink); background-color: var(--c-text); border-color: var(--c-text); }

.order-muted { color: var(--c-dim); }

/* Nút chọn tuyến RouteOption — viền, khi được chọn đảo màu.
   (Cần đè .btn-row Button vì specificity class+type cao hơn 1 class.) */
.btn-route {
    color: var(--c-text);
    background-color: transparent;
    border-width: 2px;
    border-color: var(--c-faint);
    padding: 2px 12px;
    margin-right: 10px;
    margin-bottom: 6px;
    font-size: 22px;
}
.btn-row .btn-route { color: var(--c-text); background-color: transparent; border-width: 2px; border-color: var(--c-faint); padding: 2px 12px; }
.btn-route:hover { border-color: var(--c-dim); }
.btn-row .btn-route:hover { border-color: var(--c-dim); }
.btn-route.selected { color: var(--c-ink); background-color: var(--c-text); border-color: var(--c-text); }
.btn-row .btn-route.selected { color: var(--c-ink); background-color: var(--c-text); border-color: var(--c-text); }

/* Nút hành tinh / trạm: tọa độ do C# đặt (PortDef.mapPosition), kích thước nằm ở đây.
   Nhãn đặt DƯỚI nút, nền bán trong suốt — không đè nút hay nhãn khác. */
.map-node {
    position: absolute;
    translate: -50% -50%;
    align-items: center;
}
.map-hq {
    width: 46px;
    height: 46px;
    background-color: var(--c-dim);
    border-width: 2px;
    border-color: var(--c-text);
}
.map-planet {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: var(--c-text);
    border-width: 2px;
    border-color: var(--c-faint);
}
.map-node-label {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 2px;
    color: var(--c-text);
    font-size: 20px;
    background-color: rgba(2, 12, 6, 0.7);
    padding: 0 6px;
    white-space: nowrap;
}

/* Chấm tàu (G4): cả 4 chấm cùng phosphor sáng — phân biệt bằng CHỮ CÁI ĐẦU thuyền trưởng
   (B / M / C / D) in trong chấm. Đang chọn: chấm to hơn + đảo màu (nền ink, viền sáng). */
.map-dot {
    position: absolute;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border-width: 2px;
    border-color: var(--c-ink);
    background-color: var(--c-text);
    translate: -50% -50%;
    align-items: center;
    justify-content: center;
}
.map-dot-letter { font-size: 15px; color: var(--c-ink); }
/* G5: tàu Roaming mờ hơn tàu đậu — phân biệt trạng thái bằng độ sáng, không màu mới (G4). */
.map-dot.roaming { opacity: 0.6; }
.map-dot.selected {
    width: 30px;
    height: 30px;
    background-color: var(--c-ink);
    border-color: var(--c-text);
}
.map-dot.selected .map-dot-letter { color: var(--c-text); }
/* G6.3: đơn đang chọn → chấm tàu không đủ điều kiện mờ đi (thẻ tàu cũng mờ như cũ). */
.map-dot.dimmed { opacity: 0.35; }

/* === Scrollbar kiểu CRT (áp mọi ScrollView của game) === */

.unity-scroller {
    width: 10px;
    background-color: rgba(46, 107, 71, 0.25);
    border-width: 0;
}
/* Ẩn nút mũi tên hai đầu track */
.unity-scroller .unity-repeat-button { display: none; width: 0; height: 0; }
.unity-base-slider__tracker { border-width: 0; background-color: rgba(46, 107, 71, 0.25); }
.unity-base-slider__dragger {
    background-color: var(--c-text);
    border-width: 0;
    border-radius: 4px;
}
.unity-base-slider__dragger:hover { background-color: var(--c-dim); }
.unity-base-slider__dragger:active { background-color: var(--c-dim); }
