<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Terminal/Terminal.uss?fileID=7433441132597879392&amp;guid=6d67eb319a67ae145a87b117645984db&amp;type=3#Terminal"/>
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="stage" class="stage">
            <ui:VisualElement name="screen" class="screen" style="opacity: 1;">
                <ui:VisualElement name="game" class="game">
                    <ui:VisualElement name="topbar" class="topbar">
                        <ui:Label name="top-day" text="Thời gian 0:00" class="topbar-item"/>
                        <ui:Label name="top-late" text="Trễ 0/3" class="topbar-item"/>
                        <ui:Label name="top-delivered" text="Đã giao 0/10" class="topbar-item"/>
                        <ui:Label name="top-revenue" text="Doanh thu 0" class="topbar-item"/>
                        <ui:Label name="top-phase" text="Lập kế hoạch" class="topbar-item phase"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="tabbar" class="tabbar">
                        <ui:Button name="tab-0" text="ĐƠN HÀNG" class="tab"/>
                        <ui:Button name="tab-1" text="ĐỘI TÀU" class="tab"/>
                        <ui:Button name="tab-2" text="SỰ CỐ" class="tab"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="content" class="content">
                        <ui:VisualElement name="panel-0" class="panel">
                            <ui:Label name="panel-0-hint" text="Tab ĐƠN HÀNG (đang dựng — Bước 3)." class="panel-hint"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="panel-1" class="panel">
                            <ui:Label name="panel-1-hint" text="Tab ĐỘI TÀU (đang dựng — Bước 4)." class="panel-hint"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="panel-2" class="panel">
                            <ui:Label name="panel-2-hint" text="Chưa có sự cố. Mừng quá sớm?" class="panel-hint"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <!-- Footer: nút Rời máy (trái, luôn truy cập) + nút pha (phải, ẩn riêng theo PhaseGate) -->
                    <ui:VisualElement name="bottombar" class="bottombar">
                        <ui:Button name="exit-machine" text="Rời máy (Esc)" class="exit-machine"/>
                        <ui:Button name="bottom-button" text="MAKE IT SO" class="bottom-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="start-screen" class="start-screen">
                        <ui:Label name="start-title" text="AYE AYE, BOSS... MAYBE?" class="start-title"/>
                        <ui:Label name="start-hint" text="Nhận đơn ở tab ĐƠN HÀNG — điều tàu ở tab ĐỘI TÀU: bấm tuyến là tàu khởi hành NGAY (MAKE IT SO).&#10;Đồng hồ chạy liên tục: giao đủ 10 đơn là THẮNG, trễ 3 đơn là THUA.&#10;Sự cố chờ xử lý ở tab SỰ CỐ — đồng hồ dừng đến khi chọn xong phương án." class="start-hint"/>
                        <ui:Button name="start-button" text="BẮT ĐẦU" class="start-button"/>
                        <ui:Button name="restart-button" text="CHƠI LẠI" class="start-button restart"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="tv-fx" picking-mode="Ignore" class="tv-fx">
                    <ui:VisualElement name="tv-line" picking-mode="Ignore" class="tv-line"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="debug-overlay" picking-mode="Ignore" class="debug-overlay"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
