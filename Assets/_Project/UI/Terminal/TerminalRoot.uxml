<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Terminal/Terminal.uss?fileID=7433441132597879392&amp;guid=6d67eb319a67ae145a87b117645984db&amp;type=3#Terminal"/>
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="stage" class="stage">
            <ui:VisualElement name="screen" class="screen" style="opacity: 1;">
                <ui:VisualElement name="game" class="game">
                    <ui:VisualElement name="topbar" class="topbar">
                        <ui:Label name="top-day" text="Time 0:00" class="topbar-item"/>
                        <ui:Label name="top-late" text="Late 0/3" class="topbar-item"/>
                        <ui:Label name="top-delivered" text="Delivered 0/10" class="topbar-item"/>
                        <ui:Label name="top-revenue" text="Revenue 0" class="topbar-item"/>
                        <ui:Label name="top-phase" text="Planning" class="topbar-item phase"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="tabbar" class="tabbar">
                        <ui:Button name="tab-0" text="ORDERS" class="tab"/>
                        <ui:Button name="tab-1" text="FLEET" class="tab"/>
                        <ui:Button name="tab-2" text="INCIDENTS" class="tab"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="content" class="content">
                        <ui:VisualElement name="panel-0" class="panel">
                            <ui:Label name="panel-0-hint" text="ORDERS tab." class="panel-hint"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="panel-1" class="panel">
                            <ui:Label name="panel-1-hint" text="FLEET tab." class="panel-hint"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="panel-2" class="panel">
                            <ui:Label name="panel-2-hint" text="No incidents. Too early to celebrate?" class="panel-hint"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="bottombar" class="bottombar">
                        <ui:Button name="exit-machine" text="Leave (Esc)" class="exit-machine"/>
                        <ui:Button name="bottom-button" text="MAKE IT SO" class="bottom-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="start-screen" class="start-screen">
                        <ui:Label name="start-title" text="AYE AYE, BOSS... MAYBE?" class="start-title"/>
                        <ui:Label name="start-hint" text="Accept orders in the ORDERS tab — command ships in the FLEET tab: click a route and the ship departs NOW (MAKE IT SO).&#10;The clock never stops: deliver 10 orders to WIN, be late on 3 to LOSE.&#10;No orders at the start — the first one appears after a short warm-up; read the ORDERS tab guide.&#10;Pending incidents are in the INCIDENTS tab — the clock pauses until you pick an option." class="start-hint"/>
                        <ui:Button name="restart-button" text="PLAY AGAIN" class="start-button restart"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="tv-fx" picking-mode="Ignore" class="tv-fx">
                    <ui:VisualElement name="tv-line" picking-mode="Ignore" class="tv-line"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="debug-overlay" picking-mode="Ignore" class="debug-overlay"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
