<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="Terminal.uss" />
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="stage" class="stage">
            <ui:VisualElement name="computer-image" picking-mode="Ignore" class="computer-image" />
            <ui:VisualElement name="screen" class="screen" />
            <ui:VisualElement name="debug-overlay" picking-mode="Ignore" class="debug-overlay" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
