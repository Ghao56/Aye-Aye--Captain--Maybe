<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Terminal.uss" />
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="stage" class="stage">
            <ui:VisualElement name="screen" class="screen">
                <ui:VisualElement name="tv-fx" picking-mode="Ignore" class="tv-fx">
                    <ui:VisualElement name="tv-line" picking-mode="Ignore" class="tv-line" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="debug-overlay" picking-mode="Ignore" class="debug-overlay" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
